{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rogerchappel/shellgarden/blob/main/docs/schema/shellgarden.schema.json",
  "title": "ShellGarden configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gardens"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "defaultTimeoutMs": { "type": "integer", "minimum": 1 },
    "gardens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/garden" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "garden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture", "commands"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fixture": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "run": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "expectExit": { "type": "integer", "minimum": 0 },
        "allowFail": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "transcript": { "type": "string", "minLength": 1 }
      }
    }
  }
}
